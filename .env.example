# Copy this file to ".env" (same folder) and edit. ".env" must NEVER be committed to git.
# Real environment variables ($env:NAME in PowerShell) override values in .env.

# development | test | production. In production the cookie MUST be Secure.
NIRIKSHAN_ENV=development

# Where the SQLite database lives. If your project is inside OneDrive, prefer a
# folder OUTSIDE OneDrive, e.g.:  C:\Users\<you>\AppData\Local\NIRIKSHAN\nirikshan.sqlite3
# NIRIKSHAN_DB_PATH=

# Comma-separated browser origins allowed to call the API with cookies.
NIRIKSHAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookie. Keep Secure=false for plain http://localhost; set true behind HTTPS.
NIRIKSHAN_COOKIE_SECURE=false
NIRIKSHAN_COOKIE_SAMESITE=lax

# Session lifetimes and brute-force protection.
NIRIKSHAN_SESSION_HOURS=24
NIRIKSHAN_REMEMBER_ME_DAYS=30
NIRIKSHAN_LOGIN_MAX_ATTEMPTS=5
NIRIKSHAN_LOGIN_WINDOW_MINUTES=15
